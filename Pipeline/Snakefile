# =============================================================================
# ALPHAGENOME RULES
# =============================================================================

rule run_alphagenome:
    input:
        script="Scripts/alphagenome_integration.py",
        vcf="Data/VCF/filtered_variants.vcf.gz"
    output:
        "results/alphagenome/alphagenome_scores.csv"
    params:
        organism=config.get("alphagenome", {}).get("organism", "human"),
        sequence_length=config.get("alphagenome", {}).get("sequence_length", "2KB"),
        chunk_size=config.get("alphagenome", {}).get("chunk_size", 100),
        scorers=config.get("alphagenome", {}).get("scorers", ""),
        api_key=config.get("alphagenome", {}).get("api_key", ""),
        score_column=config.get("alphagenome", {}).get("score_column", "quantile_score"),
        include_biosample=config.get("alphagenome", {}).get("include_biosample", True),
        aggregation=config["models"]["alphagenome"].get("aggregation_method", "mean"),
        use_absolute_flag="--use_absolute" if config["models"]["alphagenome"].get("use_absolute", False) else "",
        no_biosample_flag="" if config.get("alphagenome", {}).get("include_biosample", True) else "--no_biosample",
        scorers_arg=("--scorers " + config.get("alphagenome", {}).get("scorers", "")) if config.get("alphagenome", {}).get("scorers", "") else "",
        api_key_env=config.get("alphagenome", {}).get("api_key_env", "ALPHAGENOME_API_KEY")
    log:
        "logs/alphagenome/alphagenome.log"
    conda:
        "Configs/alphagenome-env.yaml"
    shell:
        """
        mkdir -p results/alphagenome/raw logs/alphagenome

        API_KEY_VALUE="{params.api_key}"
        API_KEY_VAR="{params.api_key_env}"
        if [ -z "$API_KEY_VALUE" ]; then
            API_KEY_VALUE="${{!API_KEY_VAR}}"
        fi
        if [ -z "$API_KEY_VALUE" ]; then
            echo "ERROR: no AlphaGenome API key found." >&2
            echo "Set alphagenome.api_key in Configs/config.yaml or export $API_KEY_VAR." >&2
            exit 1
        fi

        python {input.script} score \
            --vcf {input.vcf} \
            --api_key "$API_KEY_VALUE" \
            --organism {params.organism} \
            --sequence_length {params.sequence_length} \
            --chunk_size {params.chunk_size} \
            --output_raw_dir results/alphagenome/raw \
            --raw_combined results/alphagenome/alphagenome_raw_combined.tsv.gz \
            {params.scorers_arg} 2>&1 | tee {log}

        python {input.script} finalize \
            --raw_input results/alphagenome/raw \
            --pattern "*_alphagenome_raw.tsv.gz" \
            --out_csv {output} \
            --score_column {params.score_column} \
            --aggregation {params.aggregation} \
            --vcf_for_ids {input.vcf} \
            {params.use_absolute_flag} \
            {params.no_biosample_flag} 2>&1 | tee -a {log}
        """


rule merge_data_alphagenome:
    input:
        model_scores="results/alphagenome/alphagenome_scores.csv",
        vcf="Data/VCF/filtered_variants.vcf.gz"
    output:
