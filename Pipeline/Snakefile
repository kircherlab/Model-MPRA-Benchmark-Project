    input:
        merged_data="results/basenji/merged_data.tsv"
    output:
        corr_plot="results/basenji/plots/correlation.png",
        roc_plot="results/basenji/plots/roc_performance_analysis.png",
        metrics_csv="results/basenji/plots/performance_metrics.csv"
    params:
        exclude_min=config.get("exclude_min", None),
        exclude_max=config.get("exclude_max", None)
    conda:
        "Configs/basenji-env.yaml"
    shell:
        """
        mkdir -p results/basenji/plots
        EXCLUDE_ARG=""
        if [ "{params.exclude_min}" != "None" ] && [ "{params.exclude_max}" != "None" ]; then
            EXCLUDE_ARG="--exclude_range {params.exclude_min} {params.exclude_max}"
        fi
        python Scripts/generate_plots.py \
            --merged_data {input.merged_data} \
            --out_corr {output.corr_plot} \
            $EXCLUDE_ARG
        """

