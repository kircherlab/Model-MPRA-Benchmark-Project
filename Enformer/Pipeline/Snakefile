# Snakefile
configfile: "/data/humangen_kircherlab/Projects/Model_MPRA_Benchmark/02_Analysis/Enformer/Pipeline/Configs/config.yaml"

# The 'all' rule specifies the final plot files for the single analysis
rule all:
    input:
        "results/merged_data.tsv",
        "results/plots/correlation.png",
        # "results/plots/correlation.png",
        # "results/plots/roc_auc.png",
        # "results/plots/score_distribution.png"

# Rule 1: Run Enformer to predict SAD scores for all variants
rule run_enformer:
    input:
        script="Scripts/enformer_SAD_v2.py",
        vcf=config["vcf"],
        fasta=config["fasta"],
        targets=config["targets"],
        
    params:
        max_variants=config["max_variants"]
    output:
        "results/enformer_scores.csv"
    log:
        "logs/enformer.log"
    conda:
        "Configs/enformer-env.yaml" 
    shell:
        """
        python {input.script} \
            --vcf {input.vcf} \
            --fasta {input.fasta} \
            --targets {input.targets} \
            --out {output} \
            --max_variants {params.max_variants} \
            --print_every 50 2>&1 | tee -a {log}
        """


# Rule 2: Merge data with the specified MPRA file
rule merge_data:
    input:
        enformer_scores="results/enformer_scores.csv",
        vcf=config["vcf"]
    output:
        "results/merged_data.tsv"
    params:
        agg_global=config.get("agg_global", False),
        agg_global_max=config.get("agg_global_max", False),
        agg_global_min=config.get("agg_global_min", False),
        agg_per_biosample=config.get("agg_per_biosample", False),
        agg_per_biosample_max=config.get("agg_per_biosample_max", False),
        agg_per_biosample_min=config.get("agg_per_biosample_min", False),
        agg_per_assay=config.get("agg_per_assay", False),
        agg_per_assay_max=config.get("agg_per_assay_max", False),
        agg_per_assay_min=config.get("agg_per_assay_min", False),
    conda:
        "Configs/analysis-env.yaml" 
    script:
        "Scripts/merge_data.py"

# Rule 3: Generate evaluation plots from the merged data
rule generate_plots:
    input:
        merged_data="results/merged_data.tsv"
    output:
        corr_plot="results/plots/correlation.png"
    params:
        exclude_min=config.get("exclude_min", None),
        exclude_max=config.get("exclude_max", None)
    conda:
        "Configs/analysis-env.yaml"
    shell:
        """
        EXCLUDE_ARG=""
        if [ "{params.exclude_min}" != "None" ] && [ "{params.exclude_max}" != "None" ]; then
            EXCLUDE_ARG="--exclude_range {params.exclude_min} {params.exclude_max}"
        fi
        python Scripts/generate_plots.py \
            --merged_data {input.merged_data} \
            --out_corr {output.corr_plot} \
            $EXCLUDE_ARG
        """
