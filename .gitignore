# Environments
.venv/
venv/
.env
.env.*
*.env

# Python/cache/temp artifacts
__pycache__/
*.py
*.log
*.tmp
*.swp

# Pipeline outputs and checkpoints
results/
**/results/
*.ckpt/
**/*.ckpt/
Archive/
**/.snakemake/

# Reference genome files (large, obtain separately)
Data/Genome/*.fa
Data/Genome/*.fa.gz
Data/Genome/*.fai

# VCF files — ignore uncompressed, backups, and pipeline-generated filtered files
Data/VCF/*.vcf
Data/VCF/*.original
Data/VCF/*_filtered.vcf.gz
Data/VCF/filtered_variants.vcf.gz
Data/VCF/test_filtered.vcf.gz
Data/VCF/*.vcf.gz.tbi
Data/VCF/*.vcf.gz.csi
